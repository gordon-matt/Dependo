<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Lamar implementation for Dependo</Description>
		<PackageTags>dependency-injection;ioc;lamar;dependency-resolver;registrar;aspnetcore</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Lamar" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Dependo\Dependo.csproj" />
		<ProjectReference Include="..\Dependo.Generator\Dependo.Generator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" SetTargetFramework="TargetFramework=netstandard2.0" />
	</ItemGroup>
	<Import Project="..\Dependo.Generator\PackAnalyzer.targets" />
</Project>