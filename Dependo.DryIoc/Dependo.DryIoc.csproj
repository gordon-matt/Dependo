<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.3.0</Version>
		<Description>DryIoc implementation for Dependo</Description>
		<PackageTags>dependency-injection;ioc;dryioc;dependency-resolver;registrar;aspnetcore</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DryIoc.dll" Version="6.0.0-preview-09" />
		<PackageReference Include="DryIoc.Microsoft.DependencyInjection" Version="8.0.0-preview-04" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Dependo\Dependo.csproj" />
		<ProjectReference Include="..\Dependo.Generator\Dependo.Generator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" SetTargetFramework="TargetFramework=netstandard2.0" />
	</ItemGroup>

	<Import Project="..\Dependo.Generator\PackAnalyzer.targets" />
</Project>
