<Project>
	<!-- Shared NuGet package metadata for all Dependo packages -->
	<PropertyGroup>
		<Authors>Matt Gordon</Authors>
		<Company>Matt Gordon</Company>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/gordon-matt/Dependo</PackageProjectUrl>
		<RepositoryUrl>https://github.com/gordon-matt/Dependo</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>PackageIcon.jpg</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)_Misc\PackageIcon.jpg" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
