<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>A simple dependency resolution system for .NET Core applications.</Description>
		<PackageTags>dependency-injection;ioc;service-locator;dependency-resolver;registrar;aspnetcore</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Dependo.Tests" />
	</ItemGroup>
	<ItemGroup>
		<None Include="buildTransitive\Dependo.props" Pack="true" PackagePath="buildTransitive\" />
	</ItemGroup>
</Project>