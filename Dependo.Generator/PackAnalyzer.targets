<Project>
	<!-- The project reference runs the generator locally. Pack does not copy that analyzer into the nupkg, so publish it explicitly. -->
	<Target Name="IncludeDependoGeneratorInPackage" BeforeTargets="_GetPackageFiles">
		<ItemGroup>
			<None Include="$(MSBuildThisFileDirectory)bin\$(Configuration)\netstandard2.0\Dependo.Generator.dll"
			      Pack="true"
			      PackagePath="analyzers/dotnet/cs"
			      Visible="false" />
		</ItemGroup>
	</Target>
</Project>
