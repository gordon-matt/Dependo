<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.2.3</Version>
		<Description>LightInject implementation for Dependo</Description>
		<PackageTags>dependency-injection;ioc;lightinject;dependency-resolver;registrar;aspnetcore</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Extenso.Core" Version="10.2.1" />
		<PackageReference Include="LightInject" Version="7.1.1" />
		<PackageReference Include="LightInject.Microsoft.DependencyInjection" Version="4.1.2" />
		<PackageReference Include="LightInject.Microsoft.Hosting" Version="2.3.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Dependo\Dependo.csproj" />
	</ItemGroup>

</Project>
