<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>LightInject implementation for Dependo</Description>
		<PackageTags>dependency-injection;ioc;lightinject;dependency-resolver;registrar;aspnetcore</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Extenso.Core" />
		<PackageReference Include="LightInject" />
		<PackageReference Include="LightInject.Microsoft.DependencyInjection" />
		<PackageReference Include="LightInject.Microsoft.Hosting" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Dependo\Dependo.csproj" />
		<ProjectReference Include="..\Dependo.Generator\Dependo.Generator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" SetTargetFramework="TargetFramework=netstandard2.0" />
	</ItemGroup>

	<Import Project="..\Dependo.Generator\PackAnalyzer.targets" />
</Project>