<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>.NET Default implementation for Dependo</Description>
		<PackageTags>dependency-injection;ioc;microsoft-extensions-dependencyinjection;dependency-resolver;registrar;aspnetcore</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Dependo\Dependo.csproj" />
		<ProjectReference Include="..\Dependo.Generator\Dependo.Generator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" SetTargetFramework="TargetFramework=netstandard2.0" />
	</ItemGroup>

	<Import Project="..\Dependo.Generator\PackAnalyzer.targets" />
</Project>